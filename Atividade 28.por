programa
{
	
	funcao inicio()
	{
	inteiro vetor[5] ={0,0,0,0,0}

	escreva("Escreva 5 valores: \n")
	leia(vetor[0])
	leia(vetor[1])
	leia(vetor[2])
	leia(vetor[3])
	leia(vetor[4])
	escreva("\n")
	escreva("(*-*) (*~*)")
	escreva("A somas dos elementos do vetor: \n",vetor[0]+vetor[1]+vetor[2]+vetor[3]+vetor[4])
	
		
	}
}
