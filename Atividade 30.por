programa
{
	
	funcao inicio()
	{
		inteiro vetor[5]={0,0,0,0,0},valor[5]={0,0,0,0,0}
		
		para(inteiro i = 0;i < 5 ;i++){
			


			escreva("Escreva os numeros mano: \n")
			leia(vetor[i])
		}
		
		escreva("Valores",vetor[4],",",vetor[3],",",vetor[2],",",vetor[1],",",vetor[0])

	}
}
